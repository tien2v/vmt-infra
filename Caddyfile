(common) {
	root * /srv/www
	file_server
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Trang admin (nhan vien). Caddy tu xin chung chi HTTPS.
saas.7zone.net {
	import common
	header Strict-Transport-Security "max-age=31536000"
}

# Truy cap bang IP (tam thoi, de kiem tra)
:80 {
	import common
}
