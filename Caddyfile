# Tam thoi chay bang IP (http). Khi co ten mien se doi thanh:
# console.vmtglobal.com, console.vominhthien.com { ... } de tu dong co HTTPS.
:80 {
	root * /srv/www
	file_server
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
