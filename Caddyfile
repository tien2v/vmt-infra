(security) {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

# Tinh trang cap nhat tu dong (khong chua bi mat)
(deploystatus) {
	handle /deploy-status.txt {
		root * /srv/www
		header Cache-Control no-store
		file_server
	}
}

# Trang admin (nhan vien). Caddy tu xin chung chi HTTPS.
saas.7zone.net {
	import security
	request_body {
		max_size 80MB
	}
	import deploystatus
	handle {
		reverse_proxy app:3000
	}
}

# Trang khach Vominhthien (web app khach hang)
app.vominhthien.com {
	import security
	import /etc/caddy/khach.caddy
}

# Vao bang IP thi chuyen ve ten mien (dang nhap can HTTPS)
:80 {
	redir https://saas.7zone.net{uri} permanent
}
